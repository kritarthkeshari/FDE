# ---- Stage 1: build the frontend (React/Vite) ----
FROM node:22-alpine AS frontend-builder
WORKDIR /app
# Copy manifests first so "npm install" is cached unless deps change.
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ ./
RUN npm run build          # outputs /app/dist

# ---- Stage 2: backend runtime ----
FROM node:22-alpine
WORKDIR /app
# Install ONLY production backend deps (fresh, not copied from the host).
COPY backend/package*.json ./
RUN npm install --omit=dev
COPY backend/ ./
# Serve the built frontend from the backend's "public" folder.
COPY --from=frontend-builder /app/dist ./public
EXPOSE 3000
CMD ["node", "server.js"]
