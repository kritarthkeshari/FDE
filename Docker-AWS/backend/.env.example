# Copy this file to ".env" for local development:  cp .env.example .env
#
# Local dev uses a MongoDB + a MinIO (S3) running on your machine via Docker.
# In production (AWS ECS) these variables are supplied by the task definition
# and point at MongoDB Atlas + real AWS S3 -- the code never changes.

MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=codetogether

# --- Object storage (S3) ---
# LOCAL (MinIO): set all of these.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=codetogether-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
#
# S3_PUBLIC_ENDPOINT is only needed under docker-compose, where the app reaches
# MinIO at http://minio:9000 but the browser needs http://localhost:9000 for
# download links. Running the backend directly on your host (this .env) does
# NOT need it -- app and browser both use 127.0.0.1:9000.
#
# PRODUCTION (real AWS S3): LEAVE S3_ENDPOINT UNSET and OMIT the access/secret
# keys -- the AWS SDK then uses real S3 and the ECS task's IAM role for auth.
# Set only:
#   S3_REGION=<your-bucket-region>
#   S3_BUCKET=<your-bucket-name>
